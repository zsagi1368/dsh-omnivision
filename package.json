{
  "name": "dsh-omnivision",
  "version": "0.1.0-alpha",
  "description": "Next-gen DSH vision plugin: pixel-faithful + toolized + zero-config. KV-cache safe by design.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check src",
    "format": "biome check --write src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "vision",
    "vision-tools",
    "multimodal",
    "openrouter",
    "image",
    "ocr",
    "screenshot",
    "plugin"
  ],
  "author": "zsagi1368",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsagi1368/dsh-omnivision.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "compatible": ">=0.1.5-rc.2 <0.2.0",
    "autoApprove": true,
    "capabilities": [
      {
        "type": "service",
        "service": {
          "name": "dsh-omnivision/vision",
          "factory": "./dist/index.js",
          "singleton": true
        }
      }
    ],
    "sandbox": {
      "type": "inline",
      "resources": {
        "memoryLimitMb": 512,
        "cpuLimit": 50,
        "timeoutMs": 120000,
        "maxOutputBytes": 1000000
      },
      "filesystem": {
        "access": "readwrite",
        "allowedPaths": [],
        "deniedPatterns": []
      },
      "network": {
        "access": "external",
        "allowedHosts": [
          "api.openai.com",
          "api.anthropic.com",
          "generativelanguage.googleapis.com",
          "oai.endpoints.kepler.ai.cloud.ovh.net",
          "open.bigmodel.cn",
          "opencode.ai"
        ],
        "deniedHosts": [],
        "allowLocal": true
      },
      "environment": {
        "whitelist": [],
        "blacklist": [],
        "clear": false
      },
      "process": {
        "spawn": false,
        "exec": false,
        "allowedCommands": []
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0",
    "sharp": ">=0.35.3 <1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^22.19.7",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.7"
  }
}
