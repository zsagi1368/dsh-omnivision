{
  "name": "dsh-omnivision",
  "version": "0.1.0-alpha",
  "description": "Next-gen DSH vision plugin: pixel-faithful + toolized + zero-config. KV-cache safe by design.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check src",
    "format": "biome check --write src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "vision",
    "vision-tools",
    "multimodal",
    "openrouter",
    "image",
    "ocr",
    "screenshot",
    "plugin"
  ],
  "author": "zsagi1368",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsagi1368/dsh-omnivision.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependencies": {
    "sharp": ">=0.35.3 <1"
  },
  "peerDependenciesMeta": {
    "sharp": { "optional": true }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^22.19.7",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.7"
  }
}
